# Vid2Know environment — copy to project root as `.env`
# cp config/.env.example .env

# Public URLs
APP_NAME=Vid2Know
# Host port for the web gateway. Change if 8080 is already in use.
APP_PORT=8080
API_PORT=8000

# Database & queue
POSTGRES_USER=vid2know
POSTGRES_PASSWORD=vid2know_change_me
POSTGRES_DB=vid2know
DATABASE_URL=postgresql+psycopg://vid2know:vid2know_change_me@postgres:5432/vid2know
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Storage (host paths mounted into containers)
NOTES_ROOT=/data/notes
UPLOAD_ROOT=/data/uploads
CACHE_ROOT=/data/cache
# Temporary video download dir inside container (override via Settings UI as video_cache_root)
VIDEO_CACHE_ROOT=/data/cache
# Auto-delete downloaded/uploaded video after note is generated
AUTO_DELETE_VIDEO=true
# Bilibili cookies (Netscape cookies.txt). Strongly recommended to avoid HTTP 412.
# Example: COOKIES_FILE=/config/cookies.txt
COOKIES_FILE=

# ASR / OCR
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OCR_ENABLED=true
SCENE_THRESHOLD=27.0
MAX_KEYFRAMES=80

# Default analysis prompt language
DEFAULT_LOCALE=zh-CN

# CORS (comma-separated). Include Electron origin if needed.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:18080,http://localhost:18080,app://.

# Fernet key file for encrypting provider API keys in DB (auto-created on first save).
FERNET_KEY_FILE=/config/fernet.key

# Host-side notes path shown in UI only (map container NOTES_ROOT → host folder).
# HOST_NOTES_ROOT=./data/notes
